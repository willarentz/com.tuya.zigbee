{
  "id": "snzb_04_door_sensor",
  "name": {
    "en": "SNZB-04 Door & Window Sensor (eWeLink)"
  },
  "class": "sensor",
  "platforms": ["local"],
  "connectivity": ["zigbee"],
  "capabilities": [
    "alarm_contact",
    "alarm_battery"
  ],
  "energy": {
    "batteries": ["CR2032"]
  },
  "images": {
    "large": "{{driverAssetsPath}}/images/large.png",
    "small": "{{driverAssetsPath}}/images/small.png"
  },
  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Battery Settings"
      },
      "children": [
        {
          "id": "batteryThreshold",
          "type": "number",
          "label": {
            "en": "Battery alarm threshold"
          },
          "hint": {
            "en": "Battery level below which the battery alarm will be triggered (%)"
          },
          "value": 20,
          "attr": {
            "min": 5,
            "max": 50,
            "step": 1
          }
        }
      ]
    }
  ],
  "zigbee": {
    "manufacturerName": [
      "eWeLink"
    ],
    "productId": [
      "SNZB-04"
    ],
    "endpoints": {
      "1": {
        "clusters": [0, 1, 3, 1280],
        "bindings": [1, 1280]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/icon.svg",
      "instruction": {
        "en": "Long press the reset button for 5 seconds until the LED indicator flashes three times to enter pairing mode."
      }
    }
  }
}
